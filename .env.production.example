# Copy these values into your deployment provider's environment settings.
# Never commit a real .env.production file or OAuth tokens.
VITE_GOOGLE_CLIENT_ID=your-production-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_MODE=browser
VITE_APP_VERSION=0.1.0
VITE_PRODUCTION_ORIGIN=https://your-production-domain.example

# Set VITE_GOOGLE_AUTH_MODE=server to use backend refresh-token auth.
# On Razor/cPanel Node.js hosting, use the Node app in server/.
VITE_AUTH_API_BASE=/api/auth
VITE_AUTH_API_EXTENSION=

# Backend mode also requires Node app environment variables:
# GOOGLE_CLIENT_ID=your-production-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-production-oauth-client-secret
# AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# APP_ORIGIN=https://your-production-domain.example
# GOOGLE_REDIRECT_URI=https://your-production-domain.example/api/auth/google/callback
